{
  "name": "yun-elp",
  "version": "1.2.1",
  "description": "基于 Element Plus 的业务组件库",
  "private": false,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "preinstall": "npx only-allow pnpm && npm config set registry http://mirrors.cloud.tencent.com/npm/",
    "bootstrap": "pnpm install",
    "create": "tsx scripts/create-component.ts",
    "dev": "pnpm -C play dev",
    "docs:dev": "pnpm -C docs dev",
    "docs:ai": "tsx scripts/generate-ai-docs.ts",
    "test": "pnpm -C packages/components test:coverage",
    "typecheck": "pnpm -C packages/components typecheck && pnpm -C play typecheck && pnpm -C docs typecheck",
    "commit": "czg",
    "build": "pnpm build:clean && pnpm build:comp && pnpm build:style && pnpm build:resolver && pnpm build:pkg && pnpm build:web-types && pnpm build:tags",
    "build:clean": "rimraf dist",
    "build:comp": "pnpm -C packages/components build",
    "build:style": "pnpm -C packages/theme-chalk build",
    "build:resolver": "pnpm -C packages/resolver build",
    "build:pkg": "tsx scripts/copy-pkg.ts",
    "build:docs": "pnpm -C docs build",
    "build:web-types": "tsx scripts/generate-web-types.ts",
    "build:tags": "tsx scripts/generate-tags.ts",
    "lint": "pnpm lint:format && pnpm lint:eslint && pnpm lint:style",
    "lint:format": "prettier --write .",
    "lint:eslint": "eslint . --fix",
    "lint:style": "stylelint \"**/*.{vue,scss,css}\" --fix",
    "release": "release-it --config release-it.config.cjs",
    "pre-release": "node scripts/pre-publish-check.cjs --quality",
    "pre-release:full": "node scripts/pre-publish-check.cjs --quality --audit",
    "pre-publish": "node scripts/pre-publish-check.cjs --publish",
    "sync-version": "tsx scripts/sync-version.ts",
    "release:mcp": "tsx scripts/sync-version.ts && pnpm publish -F yun-elp-mcp --access public --no-git-checks",
    "prepare": "husky install",
    "publish": "cd dist && npm publish --registry=https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">= 18"
  },
  "dependencies": {
    "@yun-elp/components": "workspace:*",
    "@yun-elp/resolver": "workspace:*",
    "@yun-elp/theme-chalk": "workspace:*",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@element-plus/icons-vue": "catalog:",
    "@eslint/js": "^9.39.4",
    "@release-it/conventional-changelog": "^8.0.2",
    "@rollup/rollup-win32-x64-msvc": "^4.59.0",
    "@types/glob": "^8.1.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "catalog:",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "@vitejs/plugin-vue": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/shared": "catalog:",
    "@vue/test-utils": "catalog:",
    "@vueuse/core": "^14.3.0",
    "@vueuse/shared": "^14.3.0",
    "cron-parser": "^5.5.0",
    "cz-git": "^1.12.0",
    "czg": "^1.12.0",
    "echarts": "^6.0.0",
    "element-plus": "catalog:",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-vue": "^10.8.0",
    "glob": "^11.1.0",
    "globals": "^16.5.0",
    "gray-matter": "^4.0.3",
    "happy-dom": "^20.9.0",
    "husky": "^9.1.7",
    "inquirer": "^12.11.1",
    "lodash-es": "^4.17.23",
    "prettier": "^3.8.3",
    "release-it": "^17.11.0",
    "rimraf": "^6.1.3",
    "stylelint": "^16.26.1",
    "stylelint-config-recess-order": "^7.6.0",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-config-standard": "^39.0.1",
    "stylelint-config-standard-scss": "^16.0.0",
    "stylelint-config-standard-vue": "^1.0.0",
    "stylelint-order": "^7.0.1",
    "tsx": "^4.21.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "catalog:"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "vue-demi"
    ]
  }
}
