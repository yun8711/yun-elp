{
  "name": "yun-elp",
  "version": "1.2.2",
  "description": "基于 Element Plus 的业务组件库",
  "private": false,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "preinstall": "npx only-allow pnpm && npm config set registry http://mirrors.cloud.tencent.com/npm/",
    "bootstrap": "pnpm install",
    "create": "tsx scripts/create-component.ts",
    "dev": "pnpm -C play dev",
    "docs:dev": "pnpm -C docs dev",
    "docs:ai": "tsx scripts/generate-ai-docs.ts",
    "test": "pnpm -C packages/components test:coverage",
    "typecheck": "pnpm -C packages/components typecheck && pnpm -C play typecheck && pnpm -C docs typecheck",
    "commit": "czg",
    "build": "pnpm build:clean && pnpm build:comp && pnpm build:style && pnpm build:resolver && pnpm build:pkg && pnpm build:web-types && pnpm build:tags",
    "build:clean": "rimraf dist",
    "build:comp": "pnpm -C packages/components build",
    "build:style": "pnpm -C packages/theme-chalk build",
    "build:resolver": "pnpm -C packages/resolver build",
    "build:pkg": "tsx scripts/copy-pkg.ts",
    "build:docs": "pnpm -C docs build",
    "build:web-types": "tsx scripts/generate-web-types.ts",
    "build:tags": "tsx scripts/generate-tags.ts",
    "lint": "pnpm lint:format && pnpm lint:eslint && pnpm lint:style",
    "lint:check": "pnpm lint:format:check && pnpm lint:eslint:check && pnpm lint:style:check",
    "lint:format": "prettier --write .",
    "lint:format:check": "prettier --check .",
    "lint:eslint": "eslint . --fix",
    "lint:eslint:check": "eslint .",
    "lint:style": "stylelint \"**/*.{vue,scss,css}\" --fix",
    "lint:style:check": "stylelint \"**/*.{vue,scss,css}\"",
    "release": "release-it --config release-it.config.cjs",
    "check:release": "node scripts/pre-publish-check.cjs --quality",
    "check:publish": "node scripts/pre-publish-check.cjs --publish",
    "pre-release": "pnpm check:release",
    "pre-publish": "pnpm check:publish",
    "sync-version": "tsx scripts/sync-version.ts",
    "mcp:extract": "pnpm -C packages/mcp-server extract",
    "mcp:test": "pnpm -C packages/mcp-server test",
    "mcp:build": "pnpm -C packages/mcp-server build",
    "mcp:publish": "pnpm publish -F yun-elp-mcp --access public --no-git-checks",
    "publish": "pnpm check:publish && cd dist && npm publish --registry=https://registry.npmjs.org/",
    "publish:all": "pnpm publish && pnpm mcp:publish",
    "prepare": "husky"
  },
  "engines": {
    "node": ">= 18"
  },
  "dependencies": {
    "@yun-elp/components": "workspace:*",
    "@yun-elp/resolver": "workspace:*",
    "@yun-elp/theme-chalk": "workspace:*",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@element-plus/icons-vue": "catalog:",
    "@eslint/js": "^9.39.4",
    "@release-it/conventional-changelog": "^8.0.2",
    "@rollup/rollup-win32-x64-msvc": "^4.62.2",
    "@types/glob": "^8.1.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "catalog:",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "@vitejs/plugin-vue": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/shared": "catalog:",
    "@vue/test-utils": "catalog:",
    "@vueuse/core": "^14.3.0",
    "@vueuse/shared": "^14.3.0",
    "cron-parser": "^5.6.0",
    "cz-git": "^1.13.1",
    "czg": "^1.13.1",
    "echarts": "^6.1.0",
    "element-plus": "catalog:",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.9.2",
    "glob": "^11.1.0",
    "globals": "^16.5.0",
    "gray-matter": "^4.0.3",
    "happy-dom": "^20.10.6",
    "husky": "^9.1.7",
    "inquirer": "^12.11.1",
    "lodash-es": "^4.18.1",
    "prettier": "^3.8.4",
    "release-it": "^17.11.0",
    "rimraf": "^6.1.3",
    "stylelint": "^16.26.1",
    "stylelint-config-recess-order": "^7.7.0",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-config-standard": "^39.0.1",
    "stylelint-config-standard-scss": "^16.0.0",
    "stylelint-config-standard-vue": "^1.0.0",
    "stylelint-order": "^7.0.1",
    "tsx": "^4.22.4",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "catalog:"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "vue-demi"
    ],
    "overrides": {
      "esbuild@<=0.24.2": ">=0.25.0",
      "@octokit/plugin-paginate-rest@>=9.3.0-beta.1 <11.4.1": ">=11.4.1",
      "tmp@<=0.2.3": ">=0.2.4",
      "preact@>=10.28.0 <10.28.2": ">=10.28.2",
      "qs@>=6.7.0 <=6.14.1": ">=6.14.2",
      "markdown-it@>=13.0.0 <14.1.1": ">=14.1.1",
      "minimatch@<3.1.3": ">=3.1.3",
      "rollup@>=4.0.0 <4.59.0": ">=4.59.0",
      "minimatch@<3.1.4": ">=3.1.4",
      "ajv@<6.14.0": ">=6.14.0",
      "ajv@>=7.0.0-alpha.0 <8.18.0": ">=8.18.0",
      "qs@<6.14.1": ">=6.14.1",
      "picomatch@<2.3.2": ">=2.3.2",
      "picomatch@>=4.0.0 <4.0.4": ">=4.0.4",
      "path-to-regexp@>=8.0.0 <8.4.0": ">=8.4.0",
      "lodash-es@>=4.0.0 <=4.17.23": ">=4.18.0",
      "lodash@>=4.0.0 <=4.17.23": ">=4.18.0",
      "lodash-es@<=4.17.23": ">=4.18.0",
      "lodash@<=4.17.23": ">=4.18.0",
      "defu@<=6.1.4": ">=6.1.5",
      "vite@<=6.4.1": ">=6.4.2",
      "fast-uri@<=3.1.0": ">=3.1.1",
      "fast-uri@<=3.1.1": ">=3.1.2",
      "qs@>=6.11.1 <=6.15.1": ">=6.15.2",
      "lodash-es@>=4.0.0 <=4.17.22": ">=4.17.23",
      "lodash@>=4.0.0 <=4.17.22": ">=4.17.23",
      "tmp@<0.2.6": ">=0.2.6",
      "vite@<=6.4.2": ">=6.4.3",
      "vite@>=8.0.0 <=8.0.15": ">=8.0.16",
      "js-yaml@<=4.1.1": ">=4.2.0",
      "@babel/core@<=7.29.0": ">=7.29.6",
      "markdown-it@<=14.1.1": ">=14.2.0",
      "hono@<4.12.25": ">=4.12.25"
    }
  }
}
