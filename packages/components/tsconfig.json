{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "~/*": ["./*"],
      "@yun-elp/theme-chalk": ["../theme-chalk/src"],
      "@yun-elp/theme-chalk/*": ["../theme-chalk/src/*"]
    },
    "types": ["vue"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "hooks/**/*.ts",
    "locale/**/*.ts",
    "utils/**/*.ts",
    "index.ts",
    "components.ts",
    "defaults.ts",
    "vite-env.d.ts"
  ],
  "exclude": [
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/__tests__/**",
    "node_modules",
    "dist"
  ]
}
